<Project Sdk="Godot.NET.Sdk/4.5.1">
    <Import Project="local.props" Condition="Exists('local.props')"/>

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <ModVersion>0.100.3</ModVersion>
        <Sts2Version>0.107.0</Sts2Version>
        <Sts2DataDir Condition="'$(Sts2DataDir)' == '' and '$(Sts2Dir)' != ''">$(Sts2Dir)\data_sts2_windows_x86_64</Sts2DataDir>
        <ModOutputDir Condition="'$(ModOutputDir)' == ''">$(MSBuildProjectDirectory)\..\build\release\content</ModOutputDir>
        <ModDeployDir Condition="'$(Sts2Dir)' != ''">$(Sts2Dir)\mods\$(MSBuildProjectName)</ModDeployDir>
        <RitsuLibDeployDir Condition="'$(Sts2Dir)' != ''">$(Sts2Dir)\mods\STS2-RitsuLib</RitsuLibDeployDir>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Krafs.Publicizer" Version="2.2.1" PrivateAssets="all"/>
        <PackageReference Include="STS2.RitsuLib" Version="*"/>
    </ItemGroup>

    <ItemGroup>
        <Publicize Include="sts2" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="sts2" HintPath="$(Sts2DataDir)\sts2.dll" Private="True"/>
        <Reference Include="0Harmony" HintPath="$(Sts2DataDir)\0Harmony.dll" Private="True"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove=".godot/**"/>
        <None Include="$(MSBuildProjectName)/**"/>
        <None Include="$(MSBuildProjectName).json"/>
        <None Include="project.godot"/>
        <None Include="export_presets.cfg"/>
        <None Include="local.props.template"/>
    </ItemGroup>

    <UsingTask TaskName="GenerateFromTemplate" TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <TemplateFile Required="true" ParameterType="System.String"/>
            <OutputFile Required="true" ParameterType="System.String"/>
            <Placeholders Required="true" ParameterType="System.String[]"/>
            <Values Required="true" ParameterType="System.String[]"/>
        </ParameterGroup>
        <Task>
            <Code Type="Fragment" Language="cs">
                var content = File.ReadAllText(TemplateFile);
                for (int i = 0; i &lt; Placeholders.Length &amp;&amp; i &lt; Values.Length; i++)
                content = content.Replace(Placeholders[i], Values[i]);
                File.WriteAllText(OutputFile, content);
            </Code>
        </Task>
    </UsingTask>

    <Target Name="ValidateSts2" BeforeTargets="ResolveAssemblyReferences">
        <Error Condition="!Exists('$(Sts2DataDir)\sts2.dll')" Text="Could not find sts2.dll. Copy local.props.template to local.props and set Sts2Dir."/>
    </Target>

    <Target Name="GenerateConsts" BeforeTargets="CoreCompile">
        <GenerateFromTemplate
                TemplateFile="src/Consts.cs.template"
                OutputFile="src/Consts.cs"
                Placeholders="@ModVersion@;@Sts2Version@"
                Values="$(ModVersion);$(Sts2Version)"/>
    </Target>

    <Target Name="PackageMod" AfterTargets="Build">
        <MakeDir Directories="$(ModOutputDir)"/>
        <Error Condition="'$(GodotExe)' == '' or !Exists('$(GodotExe)')" Text="GodotExe not found. Set GodotExe in local.props or pass -p:GodotExe=..."/>
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModOutputDir)"/>
        <GenerateFromTemplate
                TemplateFile="$(MSBuildProjectName).json"
                OutputFile="$(ModOutputDir)\$(MSBuildProjectName).json"
                Placeholders="@ModVersion@;@Sts2Version@"
                Values="$(ModVersion);$(Sts2Version)"/>
        <Exec Command="&quot;$(GodotExe)&quot; --headless --export-pack BasicExport &quot;$(ModOutputDir)\$(MSBuildProjectName).pck&quot; --path &quot;$(MSBuildProjectDirectory)&quot;" ContinueOnError="true"/>
        <MakeDir Directories="$(ModOutputDir)\..\artifacts"/>
        <ZipDirectory SourceDirectory="$(ModOutputDir)"
                      DestinationFile="$(ModOutputDir)\..\artifacts\$(MSBuildProjectName)-$(ModVersion).zip"
                      Overwrite="true"/>
    </Target>

    <Target Name="DeployMod" AfterTargets="PackageMod" Condition="'$(ModDeployDir)' != ''">
        <ItemGroup>
            <OutputFiles Include="$(ModOutputDir)\*"/>
        </ItemGroup>
        <RemoveDir Directories="$(ModDeployDir)" Condition="Exists('$(ModDeployDir)')"/>
        <Copy SourceFiles="@(OutputFiles)" DestinationFolder="$(ModDeployDir)"/>
    </Target>
</Project>
